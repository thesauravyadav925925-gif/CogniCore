    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.24.4",
    "node-sql-parser": "^4.18.0",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "tar": "^7.5.22",
    "uuid": "^14.0.3",
