# Copy this file to .env and adjust values. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# --- LLM Provider (Ollama is default & primary, no API key required) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=60000
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Document / RAG settings ---
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=150
RETRIEVAL_TOP_K=5

JWT_SECRET=CHANGE_ME_dev_only_insecure_secret
JWT_EXPIRY=7d
BCRYPT_ROUNDS=10

# --- Storage ---
DATA_DIR=./data
UPLOADS_DIR=./uploads
REGISTRY_DB_PATH=./data/cognicore_registry.db

# --- Query safety ---
MAX_RESULT_ROWS=1000
QUERY_TIMEOUT_MS=15000

# --- Upload limits ---
MAX_FILE_SIZE_MB=100

# ===================== Added in v0.2 (blueprint features) =====================
# --- Guardrails ---
CHAT_RATE_LIMIT_PER_MIN=30            # per-user chat requests per minute
PII_MASK_ROLES=viewer,employee        # roles that see emails/phones/ID numbers masked

# --- Actions (human-approval workflow) ---
ACTION_EMAIL_ALLOWED_DOMAINS=         # e.g. yourcompany.com,partner.com  (empty = any)
ACTION_ALLOW_SELF_APPROVAL=false      # true lets a manager approve their own request (admins always can)
ACTION_WEBHOOK_ALLOWLIST=             # host list for webhook actions, e.g. hooks.slack.com  (empty = webhooks disabled)
# Real email delivery (otherwise emails are recorded in the outbox, not sent):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=cognicore@yourcompany.com

# --- REST / GraphQL connector ---
API_CONNECTOR_ALLOWED_HOSTS=          # optional host allowlist, e.g. api.yourcompany.com
API_CONNECTOR_MAX_MB=20
API_CONNECTOR_ALLOW_PRIVATE=false     # keep false in production (SSRF protection)

# --- Python data-science tool ---
PYTHON_BIN=                           # optional; defaults to python3/python. Falls back to JS if missing.

# ===================== Added in v0.3 (target architecture) =====================
# --- Model router: per-task models (all optional; unset = the default OLLAMA_MODEL) ---
# OLLAMA_MODEL_SQL=qwen2.5-coder:7b       # fast model for SQL generation
# OLLAMA_MODEL_REASONING=llama3.1:8b      # stronger model for explanations
# OLLAMA_MODEL_REWRITE=qwen2.5:3b         # follow-up rewriting
# OLLAMA_MODEL_PLANNER=qwen2.5:7b
# --- Optional cloud providers (OFF by default; CogniCore is local-first) ---
# LLM_PROVIDER=ollama                     # ollama | openai | anthropic   (per task: LLM_PROVIDER_SQL=...)
# OPENAI_API_KEY=   OPENAI_BASE_URL=   OPENAI_MODEL=
# ANTHROPIC_API_KEY=   ANTHROPIC_MODEL=
# --- SQL cost / complexity limits ---
SQL_MAX_LENGTH=4000
SQL_MAX_JOINS=6
SQL_MAX_SUBQUERY_DEPTH=4
# --- OCR for scanned PDFs (needs tesseract + poppler installed) ---
OCR_LANG=eng
